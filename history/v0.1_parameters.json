{
  "schema_version": "0.1.2-candidate",
  "date": "2026-10-09",
  "status": "独立推荐方案，未代表用户已确认；非生产游戏",
  "reference_level": 20,
  "level_range": [
    1,
    60
  ],
  "formula": {
    "damage": "floor(ATK_or_DEF * coefficient * (120+4*attacker_level)/(120+4*attacker_level+target_DEF) * element_multiplier * (1.5 if already_broken else 1) * (1+min(0.5,damage_amp)) * mitigation)",
    "element_default": 1.0,
    "element_resistant": 0.8,
    "weakness_damage_bonus": 0.0,
    "break_damage_multiplier": 1.5,
    "critical_rate": 0.0,
    "hit_rate": 1.0,
    "hp_level_multiplier": "0.5 + 0.025 * L",
    "atk_def_level_multiplier": "0.6 + 0.02 * L",
    "speed_growth": 0,
    "rounding": "floor each target damage packet; animation hits collapse to one direct packet, separate status packets; all packets use action-start broken snapshot; round_half_up positive stats"
  },
  "rules": {
    "party_size_max": 4,
    "enemy_size_max": 4,
    "normal_actions_per_round": 1,
    "wait_per_round": 1,
    "wait_destination": "tail FIFO; token unchanged",
    "shield_match": "element OR weapon, not sum",
    "break_per_action_target_cap": 3,
    "break_duration": "through end of round r+1; restore at start r+2",
    "elite_boss_recovery_lock": "shield floor 1 until first normal enemy action completes after recovery",
    "concerto_cap": 100,
    "concerto_start": 0,
    "concerto_per_actor_per_round": 1,
    "concerto_grant_events": [
      "own_normal_action_effective"
    ],
    "concerto_hard_gain_cap_per_normal_action": 25,
    "concerto_intros_grant_concerto": false,
    "concerto_damage_amp_stack": "strongest only",
    "concerto_buff_expiry": "next eligible normal action, no later than end next round",
    "intro_resource_gain_cap_per_recipient_round": 20,
    "resource_start": "all 0",
    "resource_persistence": "reset each encounter; HP persists by scenario, no automatic full heal",
    "status_damage_triggers_resources": false,
    "no_extra_actions": true,
    "guard_multiplier": 0.5,
    "non_guard_mitigation_floor": 0.65,
    "barrier_cap_fraction": 0.25,
    "resurrection_baseline": false,
    "cosmetics_change_stats": false,
    "break_attack_gets_break_bonus": false,
    "weakness_visibility": "Balance tests know all enemy weaknesses. Recommended initial UI shows all weaknesses in this test package. survey reveal is implemented but discovery gameplay remains outside performance claims.",
    "status_amp": "Status packets do not inherit field/ordinary outro damage amp; cutline and special status outro add 0.25 each, capped together at +0.50.",
    "phase_queue": "At phase announcement, replace next ordinary boss action with wingpulse; never insert a new action. Pending break delays that action.",
    "recovery_policy": "No enrage clock in this candidate. A slow tank/healer team may stalemate; timeout in experiment is inconclusive, never forced defeat.",
    "pry": "Always exactly one shield point per target; tune can add damage but never extra shield reduction to pry.",
    "battlefield_orientation": "Enemies on screen left face right; allies on screen right face left. Screen orientation is not anatomical left/right; do not mirror asymmetrical assets.",
    "outro_channels": "Take strongest direct amp and strongest liberation-extra independently; the two count toward direct +50% cap with field. Status-outro has a separate one-use token until end of grant round+2 and is consumed by the next qualifying status damage from its recipient, including a previously placed marker; no direct attack consumes that token. Intro gain stays <=20 per recipient per round. Solo self-concerto grants half direct amp only; no intro or special channel."
  },
